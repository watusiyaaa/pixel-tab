{
  "manifest_version": 3,
  "name": "Pixel Tab",
  "version": "1.0.1",
  "description": "Pixel Tab: Simple Chrome New Tab Extension. Intended for personal use",
  "permissions": ["geolocation"],
  "host_permissions": ["https://api.open-meteo.com/*"],
  "icons": {
    "16": "icons/extension/icon-16.png",
    "48": "icons/extension/icon-48.png",
    "128": "icons/extension/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
